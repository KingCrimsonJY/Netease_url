# 复制为 .env 后按需修改；所有项都可以留空使用默认值。
# 相对路径以项目目录为基准。

# ---------- 服务 ----------
# 监听地址：本机使用保持 127.0.0.1；Docker 镜像内默认 0.0.0.0
HOST=127.0.0.1
PORT=5000
# 访问令牌。服务能被其他设备访问时一定要设置，否则任何人都能用你的会员账号
API_TOKEN=
# 允许跨域访问的来源，逗号分隔；留空表示只允许同源（网页界面本身不受影响）
CORS_ORIGINS=
# 每个 IP 每分钟最多请求网易云相关接口的次数，0 表示不限制
RATE_LIMIT_PER_MINUTE=60
# 部署在 nginx 等反向代理后面时设为 true，按 X-Forwarded-For 识别客户端 IP
TRUST_PROXY=false
LOG_LEVEL=INFO

# ---------- 账号 ----------
# cookie 文件，只需要包含 MUSIC_U；os、appver 等设备参数会自动补全
COOKIE_FILE=cookie.txt
# 设备身份（一般不用改）。cookie 文件里写了 os/appver 时以 cookie 为准
NETEASE_OS=pc
NETEASE_APPVER=

# ---------- 下载与缓存 ----------
# 数据目录：cache/ 下载缓存、logs/ 日志
DATA_DIR=data
# 缓存上限（GB），超过后删除最久未使用的文件；0 表示不限制
MAX_CACHE_GB=20
MAX_CONCURRENT_DOWNLOADS=3
# 默认音质：standard higher exhigh lossless hires jyeffect sky dolby vivid jymaster
DEFAULT_LEVEL=lossless
# 可选：下载后按友好文件名硬链接到这个目录（例如 NAS 上的音乐库）
LIBRARY_DIR=

# ---------- 元数据 ----------
# 封面边长（像素），0 表示使用原图（可能是几 MB 的 PNG）
COVER_SIZE=1200
# 歌词：embed 写进文件 / lrc 导出同名 .lrc（仅 LIBRARY_DIR 和命令行导出）/ both / none
LYRICS_MODE=embed
# 翻译歌词：merge 在原文下一行插入译文 / none
LYRICS_TRANSLATION=merge
# MP3 标签版本：4（默认）多位艺人分开存储，名字里带 / 的艺人（如 AC/DC）不会被拆开；
# 3 兼容很老的播放器和车机，但多位艺人只能用 / 连接
ID3_VERSION=4

# ---------- 文件名 ----------
# 可用变量：{artists} {artist} {title} {album} {track:02d} {disc} {year} {level} {quality_name} {id}
FILENAME_TEMPLATE={artists} - {title}
ARTIST_SEPARATOR=", "
MAX_ARTISTS_IN_FILENAME=3
# 非法字符 / \ : * ? " < > | 替换为全角字符（false 则替换为 _）
FULLWIDTH_REPLACE=true
